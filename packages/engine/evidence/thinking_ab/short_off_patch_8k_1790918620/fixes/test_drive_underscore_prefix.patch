--- a/packages/nodus/nodus_tools.py
+++ b/packages/nodus/nodus_tools.py
@@ -1246,3 +1246,9 @@
     s = _collapse_doubled_first_segment(s)
     s = _strip_spurious_basename_underscore(s)
-    return s
+    # Ensure basename underscore removed for Windows paths
+    last_slash = max(s.rfind('/'), s.rfind('\\'))
+    if last_slash != -1:
+        base = s[last_slash+1:]
+        if base.startswith('_') and not base.startswith('__') and base != '__init__.py':
+            s = s[:last_slash+1] + base[1:]
+    return s
</patch>
