# ---------------------------------------------------------------------------
# Nodus-GPU Engine - configuration (copier en .env, ne jamais committer .env)
# ---------------------------------------------------------------------------

# --- Modes (defaut = mock partout : aucun credential, CI-friendly) ---
NGE_FLEET_MODE=mock            # mock | nebius
NGE_SANDBOX=mock               # mock | token_factory
NGE_TRACK=                     # vide | nebius  (nebius => le garde exige un modele nebius:)
NGE_OUT_DIR=                   # defaut: packages/engine/out

# --- Inference : Nemotron via Nebius Token Factory (API OpenAI-compatible) ---
NEBIUS_API_KEY=                # ou fichier packages/engine/.nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# Modeles Nemotron 3 sur Token Factory :
#   nvidia/nemotron-3-super-120b-a12b   (defaut - multi-agent + raisonnement)
#   nvidia/nemotron-3-nano-30b-a3b      (compact)
#   Nemotron 3 Ultra 550b              (agents long-running - id a confirmer)
NEMOTRON_MODEL=nebius:nvidia/nemotron-3-super-120b-a12b

# --- Execution isolee : Token Factory Sandboxes (ConTree SDK, chemin live) ---
# SDK : pip install contree-sdk   (classes Contree / ContreeSync)
TOKEN_FACTORY_BASE_URL=
TOKEN_FACTORY_API_KEY=

# Projet Token Factory des sandboxes (forme aiproject-...), ou fichier
# packages/engine/.nebius_project_id. Ne PAS y mettre l'id Compute.
NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1

# --- Compute GPU (VM reelles, nvidia-smi) - docs/COMPUTE_GPU.md ---
# Verification sans appel API : python -m nge.fleet.compute
# Auth (une des trois) : fichier credentials de service account,
#   profil CLI `nebius` (~/.nebius/config.yaml), ou NEBIUS_IAM_TOKEN.
NEBIUS_SA_CREDENTIALS_FILE=    # defaut packages/engine/.nebius_sa_credentials.json
NEBIUS_IAM_TOKEN=
NEBIUS_COMPUTE_PROJECT_ID=     # projet AI Cloud (pas aiproject-...) ou .nebius_compute_project_id
NEBIUS_SUBNET_ID=              # Phase 2 seulement, ou .nebius_compute_subnet_id
